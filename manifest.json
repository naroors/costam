{
  "manifest_version": 3,
  "name": "Jebacz Egzaminu INF-04 Teoria",
  "version": "1.2",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://192.168.*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jeb Egzamin"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Skrót do otwarcia"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]

}
